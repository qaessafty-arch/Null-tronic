{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NULL-TECH Circuit Studio",
  "version": "0.1.0",
  "identifier": "tech.null.circuitstudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "NULL-TECH Circuit Studio", "width": 1440, "height": 900, "minWidth": 1024, "minHeight": 640 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self' ws://127.0.0.1:* ws://localhost:* ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Electrical engineering design, simulation and visualisation",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
