{
  "name": "null-tech-circuit-studio-workspace",
  "private": true,
  "description": "NULL-TECH CIRCUIT STUDIO — repository scripts",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm run test:frontend && npm run test:backend && npm run test:e2e",
    "test:frontend": "npm --prefix frontend run typecheck && npm --prefix frontend test",
    "test:backend": "cd backend && python3 -m pytest -q",
    "test:e2e": "node tests/e2e/workflows.mjs",
    "backend": "cd backend && python3 -m nulltech_backend",
    "backend:demo": "cd backend && python3 -m nulltech_backend --replay demo"
  }
}
